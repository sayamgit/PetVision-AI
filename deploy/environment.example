# Set values privately in the host dashboard. This file contains no credentials.
PETVISION_DEBUG=0
DJANGO_SETTINGS_MODULE=config.production
PETVISION_SECRET_KEY=
# Render assigns these automatically. Set explicitly only for a custom domain or another host.
# PETVISION_ALLOWED_HOSTS=pets.example.com,localhost,127.0.0.1
# PETVISION_PUBLIC_BASE_URL=https://pets.example.com
PETVISION_STORAGE_MODE=supabase
PETVISION_DB_HOST=
PETVISION_DB_PORT=5432
PETVISION_DB_NAME=postgres
PETVISION_DB_USER=
PETVISION_DB_PASSWORD=
# Optional path to Supabase CA certificate; enables verify-full TLS.
PETVISION_DB_SSL_ROOT_CERT=
PETVISION_S3_ENDPOINT=
PETVISION_S3_REGION=
PETVISION_S3_BUCKET=petvision-photos
PETVISION_S3_ACCESS_KEY_ID=
PETVISION_S3_SECRET_ACCESS_KEY=
# Render routes public requests through its HTTPS proxy.
PETVISION_TRUSTED_PROXY=*
PETVISION_PROXY_ONLY_NETWORK=1
PETVISION_PROXY_COUNT=1
GEMINI_API_KEY=
PETVISION_FREE_TIER_CONFIRMED=1
# Only for a separate deployment with an actual persistent volume:
# PETVISION_STORAGE_MODE=disk
# PETVISION_DATA_DIR=/data
