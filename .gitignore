# Keep the published repository focused. Local research/data stay on this computer.
/*
!/.gitignore
!/.dockerignore
!/.github/
!/README.md
!/render.yaml
!/deploy/
!/requirements/
!/backend/
!/docs/
!/ml/
!/tools/

/docs/*
!/docs/app-setup.md
!/docs/deployment.md
!/docs/architecture.md
!/docs/repository.md
!/docs/model-card.md
!/docs/care-planner.md
!/docs/pet-chat.md
!/docs/verification-20261021.md
!/docs/supabase-setup.sql

/ml/*
!/ml/artifacts/
/ml/artifacts/*
!/ml/artifacts/curated-v2/
/ml/artifacts/curated-v2/*
!/ml/artifacts/curated-v2/cat/
!/ml/artifacts/curated-v2/dog/
/ml/artifacts/curated-v2/*/*
!/ml/artifacts/curated-v2/*/best_model.pt
!/ml/artifacts/curated-v2/*/model_metadata.json
!/ml/artifacts/curated-v2/*/test_metrics.json

/tools/*
!/tools/package_release.py
!/tools/repository_files.py
!/tools/check_repository.py
!/tools/qa/
!/tools/windows/

# Private state and generated output are never published.
.env
.env.*
*.env
*.sqlite3*
*.db
.local-secret
__pycache__/
*.py[cod]
*.log
*.pem
*.key
*.pfx
venv/
.venv/
node_modules/
private-media/
backups/
staticfiles/
dist/
build/
.DS_Store
Thumbs.db
