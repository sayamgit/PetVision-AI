# Track application files and the two documented review datasets.
/*
!/.gitignore
!/.dockerignore
!/.github/
!/README.md
!/render.yaml
!/deploy/
!/requirements/
!/backend/
!/docs/
!/ml/
!/tools/
!/dataset/
/dataset/*
!/dataset/Pet_vision_DS.zip
!/dataset/PetVision_dataset_v2.zip
!/dataset/README.md
!/dataset/CURATION_POLICY.md
!/dataset/checksums.json
!/dataset/training_manifest.json
!/dataset/verify_dataset.py
!/dataset/PetVision_Colab_Training_v2.ipynb

/docs/*
!/docs/app-setup.md
!/docs/deployment.md
!/docs/architecture.md
!/docs/repository.md
!/docs/model-card.md
!/docs/care-planner.md
!/docs/pet-chat.md
!/docs/verification-20261021.md
!/docs/supabase-setup.sql
!/docs/review-evidence/
/docs/review-evidence/*
!/docs/review-evidence/README.md
!/docs/review-evidence/test-report-20261107.txt

/ml/*
!/ml/artifacts/
/ml/artifacts/*
!/ml/artifacts/curated-v2/
/ml/artifacts/curated-v2/*
!/ml/artifacts/curated-v2/cat/
!/ml/artifacts/curated-v2/dog/
/ml/artifacts/curated-v2/*/*
!/ml/artifacts/curated-v2/*/best_model.pt
!/ml/artifacts/curated-v2/*/model_metadata.json
!/ml/artifacts/curated-v2/*/test_metrics.json

/tools/*
!/tools/package_release.py
!/tools/repository_files.py
!/tools/check_repository.py
!/tools/qa/
!/tools/windows/

# Private state and generated output are never published.
.env
.env.*
*.env
*.sqlite3*
*.db
.local-secret
__pycache__/
*.py[cod]
*.log
*.pem
*.key
*.pfx
venv/
.venv/
node_modules/
private-media/
backups/
staticfiles/
dist/
build/
.DS_Store
Thumbs.db
